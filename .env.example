# Personal Activity & Telemetry API Configuration

# Host and Port
API_HOST=127.0.0.1
API_PORT=8000

# Secret API Key required for writing telemetry events and accessing private endpoints
# Generate a custom key or use this random secret
API_SECRET_KEY=my_secure_telemetry_key_9f8d7e6c5b4a321

# Local Database path
DATABASE_URL=sqlite:///./data/telemetry.db

# Privacy and workspace settings
# Base directory path to strip from file paths to ensure anonymity
WORKSPACE_ROOT=D:/SOURCE CODE

# GitHub Integration (Optional)
# Set your GitHub username and Personal Access Token (PAT) for GitHub activity sync
GITHUB_USERNAME=
GITHUB_PAT=

# Heartbeat inactivity threshold in seconds (default 5 mins = 300s)
HEARTBEAT_TIMEOUT_SECONDS=300
